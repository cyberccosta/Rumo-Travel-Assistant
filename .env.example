# Escolha o provedor de IA: gemini (gratuito para testes) ou claude (pago)
LLM_PROVIDER=gemini

# Gemini: chave grátis em https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# usado automaticamente se o principal estiver sobrecarregado
GEMINI_MODEL_RESERVA=gemini-2.5-flash-lite

# Claude: só precisa se LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Opcional (atrações): chave gratuita em opentripmap.io
OPENTRIPMAP_KEY=
